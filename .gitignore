# --- Secrets / credentials (ABSOLUTE NEVER COMMIT) ---
# This repo is PUBLIC as of 2026-05-21. The exclusions below are load-bearing.
# scripts/commit_session.ps1 also refuses to stage files matching
# `\.env$|token|secret|credential` as a defense-in-depth check.
*.env
.env
.env.*
credentials.json
*_token.txt
*_secret*
.claude/channels/**/.env

# --- Python build/cache ---
__pycache__/
*.py[cod]
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
~$*

# --- Logs (re-derivable; keep findings_*.md instead) ---
logs/
audit_trail.md.bak

# --- Background task scratch ---
*.tmp
tmp/

# --- Sprint runtime state (regenerable; staged-batch resumes idempotently) ---
staging/
staged_validation_queue.json
paper_forward_positions_full.json
logs_*.txt

# --- Sprint driver runtime log (Task Scheduler launcher; grows per fire) ---
scripts/sprint_task.log

# --- Transient/ephemeral sprint artifacts (NEVER commit — PROJECT_MAP 8b T2) ---
# The pause flag is raised/removed in-session and must never be published (it
# was once swept to origin by a blanket stage and silently paused Track 1).
# *_out.txt are tee'd detector/push stdout captures, regenerated every fire.
scripts/cron_paused.flag
*_out.txt

# --- Crash-watchdog runtime files (state churns every minute, log grows) ---
# crash_log.md / crash_log.json ARE tracked — they're the incident history.
# These two are minute-by-minute internals.
scripts/cc_watchdog.log
scripts/cc_watchdog_state.json
scripts/cc_watchdog_recovery.lock

# --- Local-only CEO directive text (40KB+ raw v7.0 prose) ---
_instructions_v7.txt
_scope_v7.txt

# --- Graphify knowledge-graph output (regenerable via /graphify) ---
graphify-out/

# --- Working-area analysis scratch (derived snapshot, no code references) ---
_head_wa.json

# --- Large data caches (raw market data, rebuildable) ---
data_cache/
*.parquet
*.feather

# Keep these explicitly even though they look like cache:
# - validation_*.json (results — real state)
# - universe/*.txt + universe/*.xlsx + universe/*.json
# - aig/audit_trail.md
# - ceo_brain.md, findings_*.md
# - strategy_register.md
# - pine/*.pine
